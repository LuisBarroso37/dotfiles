.DS_Store

# Optional per-machine install steps, sourced by install.sh / install.linux.sh
# if present (extra packages, yazi's preview deps). Stays untracked & portable.
install.local.sh

# Neovim: guard against anything a plugin might generate inside the *config* dir
# at runtime. LazyVim keeps real state in ~/.local/share, ~/.local/state and
# ~/.cache/nvim (outside this repo), so these are just belt-and-suspenders for
# plugins that occasionally drop generated files next to the config.
nvim/.cache/
nvim/plugin/
nvim/data/

# Atuin runtime files written alongside config.toml. On a fresh machine
# ~/.config/atuin does not exist, so stow FOLDS the package into a directory
# symlink → ~/dotfiles/atuin/, and atuin then writes these *inside the repo*,
# where `git add -A` would happily commit them (TERMINAL.md is its AI context
# file and can carry machine/work context). Once ~/.config/atuin exists as a real
# directory stow unfolds into per-file links and the files land outside the repo —
# which is the only reason this machine was never exposed. Databases need no rule:
# every atuin db path derives from data_dir, i.e. ~/.local/share/atuin/.
atuin/atuin-receipt.json
atuin/TERMINAL.md

# tmux plugins managed by tpm (cloned into tmux/plugins/ at install time).
# Only the catppuccin theme is tracked, as a git submodule (see .gitmodules).
tmux/plugins/tpm
tmux/plugins/tmux-sensible
tmux/plugins/tmux-yank
tmux/plugins/tmux-resurrect
tmux/plugins/tmux-continuum

# Herdr runtime files written alongside config.toml when stow folds ~/.config/herdr
# into a directory symlink → ~/dotfiles/herdr/ on a fresh machine.
herdr/*.log
herdr/*.sock
herdr/session.json
herdr/.plugins.lock

# Yazi flavors are vendored (committed) so the repo is self-contained — no
# `ya pkg install` needed at bootstrap. Only skip the non-functional extras:
# the preview screenshot and the upstream readme. flavor.toml + tmtheme.xml +
# licenses stay tracked. Run `ya pkg upgrade` to refresh a flavor.
yazi/flavors/*/preview.png
yazi/flavors/*/README.md

# Karabiner runtime state. Same shape as the atuin note above: install.sh points
# ~/.config/karabiner at macos/karabiner/ as a *directory* symlink (a file-level
# link on karabiner.json does not survive Karabiner's rename(2) save), so
# everything Karabiner writes into its config dir now lands inside the repo.
# Only karabiner.json is worth tracking. automatic_backups/ in particular is a
# dated copy of the config on every save — left untracked it would otherwise
# accumulate a new ~60KB blob in git each time a setting changes.
macos/karabiner/automatic_backups/
macos/karabiner/assets/
macos/karabiner/log/
macos/karabiner/*.tmp
