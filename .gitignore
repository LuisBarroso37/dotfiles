.DS_Store

# Neovim state (not config). Paths are relative to the flat package layout:
# nvim/ is stowed to ~/.config/nvim, so runtime state lands under nvim/.
nvim/.cache/
nvim/plugin/
nvim/data/

# Atuin history DB (only config.toml is tracked, not the database)
atuin/history.db
atuin/*.db

# tmux plugins managed by tpm (cloned into tmux/plugins/ at install time).
# Only the catppuccin theme is tracked, as a git submodule (see .gitmodules).
tmux/plugins/tpm
tmux/plugins/tmux-sensible
tmux/plugins/tmux-yank
tmux/plugins/tmux-resurrect
tmux/plugins/tmux-continuum
