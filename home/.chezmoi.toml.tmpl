{{- /* The work folder and email stay out of this public repo. chezmoi init asks for them once and keeps them in ~/.config/chezmoi/chezmoi.toml. */ -}}
{{- $workDir := get . "workDir" | default "" -}}
{{- $workEmail := get . "workEmail" | default "" -}}
{{- if stdinIsATTY -}}
{{-   $workDir = promptStringOnce . "workDir" "Work folder whose repos use the work git identity, for example ~/work (empty to skip)" -}}
{{-   $workEmail = promptStringOnce . "workEmail" "Work git email (empty to skip)" -}}
{{- end -}}
sourceDir = {{ .chezmoi.workingTree | quote }}

[data]
  workDir = {{ $workDir | trimSuffix "/" | quote }}
  workEmail = {{ $workEmail | quote }}
