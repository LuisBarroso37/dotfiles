# Runtime files that tools write next to their tracked config. Listing them here
# stops `chezmoi add` on a whole directory from copying them into the repo.
# atuin's TERMINAL.md is its AI context file and can carry machine/work context.
.config/atuin/atuin-receipt.json
.config/atuin/TERMINAL.md
.config/herdr/*.log
.config/herdr/*.sock
.config/herdr/session.json
.config/herdr/.plugins.lock
.config/worktrunk/approvals.toml

# OpenCode writes these itself. service.json holds the background service password.
.config/opencode/service.json
.config/opencode/backups
.config/opencode/node_modules
.config/opencode/package.json
.config/opencode/package-lock.json
.config/opencode/bun.lock
.config/opencode/.gitignore
# Trellis generates its plugin with an absolute path to its helper.
.config/opencode/plugins
# These skills carry client material, so they stay on the work machine only.
.config/opencode/skills/create-mr
.config/opencode/skills/show-your-work

# TPM clones every tmux plugin here at install time.
.config/tmux/plugins

# Yazi flavors are vendored so no `ya pkg install` is needed at bootstrap.
# Skip the non-functional extras: the preview screenshot and the upstream readme.
.config/yazi/flavors/*/preview.png
.config/yazi/flavors/*/README.md
