# The keys themselves are not in this repo. Copy them to ~/.ssh by hand.

# Before any Host: inside a block it only applies when that block matches, so Linux ssh rejects UseKeychain for other hosts.
IgnoreUnknown UseKeychain

Host github-personal
  HostName github.com
  User git
  IdentityFile ~/.ssh/id_ed25519_personal
  IdentitiesOnly yes
  AddKeysToAgent yes
  UseKeychain yes
{{- with get . "workGitHost" }}

Host {{ . }}
  User git
  IdentityFile ~/.ssh/id_ed25519_work
  IdentitiesOnly yes
  AddKeysToAgent yes
  UseKeychain yes
{{- end }}
