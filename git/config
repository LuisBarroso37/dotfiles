# Portable git settings, tracked in dotfiles → stowed to ~/.config/git/config.
# Machine-specific identity (user.name/email) stays in ~/.gitconfig, which is
# untracked; git reads and merges both files.

[core]
	pager = delta

[interactive]
	diffFilter = delta --color-only

[delta]
	features = catppuccin-mocha  # theme defined below (syntax-theme ships with bat >= 0.26)
	navigate = true              # jump between diff hunks with n / N
	line-numbers = true
	side-by-side = true          # two-column diffs; override per-command with -c delta.side-by-side=false
	dark = true
	hyperlinks = true            # clickable file:line links in supporting terminals

[merge]
	conflictstyle = zdiff3       # clearer 3-way conflict markers

[diff]
	colorMoved = default         # distinguish moved lines from add/delete

# Catppuccin Mocha theme for delta — vendored from https://github.com/catppuccin/delta
# (enabled via `features = catppuccin-mocha` above).
[delta "catppuccin-mocha"]
	blame-palette = "#1e1e2e #181825 #11111b #313244 #45475a"
	commit-decoration-style = "#6c7086" bold box ul
	dark = true
	file-decoration-style = "#6c7086"
	file-style = "#cdd6f4"
	hunk-header-decoration-style = "#6c7086" box ul
	hunk-header-file-style = bold
	hunk-header-line-number-style = bold "#a6adc8"
	hunk-header-style = file line-number syntax
	line-numbers-left-style = "#6c7086"
	line-numbers-minus-style = bold "#f38ba8"
	line-numbers-plus-style = bold "#a6e3a1"
	line-numbers-right-style = "#6c7086"
	line-numbers-zero-style = "#6c7086"
	minus-emph-style = bold syntax "#694559"
	minus-style = syntax "#493447"
	plus-emph-style = bold syntax "#4e6356"
	plus-style = syntax "#394545"
	map-styles = \
		bold purple => syntax "#5b4e74", \
		bold blue => syntax "#445375", \
		bold cyan => syntax "#446170", \
		bold yellow => syntax "#6b635b"
	syntax-theme = Catppuccin Mocha
