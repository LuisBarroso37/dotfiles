#!/bin/sh
# git credential helper — the gitlab.com personal access token, read from 1Password.
#
# Wired up in ~/.config/git/config as `helper = op-gitlab`; git resolves that name
# to `git-credential-op-gitlab` on PATH. The point of the indirection is that the
# tracked git config then carries an op:// item reference and never a token, so
# nothing on disk is a secret. netrc cannot do this — its format is literal-only,
# which is why ~/.netrc was replaced by this rather than templated.
#
# `go` reaches the same helper through GOAUTH="git $HOME" (see `go help goauth`),
# so both legs of a private-module fetch share one credential source: the
# ?go-get=1 meta lookup the go command performs itself, and the `git clone` it
# then shells out to.
#
# Only `get` is answered. git also invokes helpers with `store` and `erase`;
# 1Password is the store and there is nothing here to persist or revoke, so those
# exit 0 quietly instead of failing the helper chain.
[ "$1" = get ] || exit 0

# Drain the request git wrote to stdin. The config section this helper sits under
# already scopes it to https://gitlab.com so there is nothing to match on, but a
# helper that never reads its input risks SIGPIPE on git's side.
cat >/dev/null 2>&1

item='op://Employee/gitlab-access-token-api_read-repository_read-golang-private-modules/notesPlain'

# Failures stay silent and exit 0: a helper that errors out aborts the chain,
# whereas one that returns nothing lets git fall through to whatever comes next
# and produce its own "could not read Username" message, which is the clearer
# error when 1Password is simply locked.
token=$(op read --no-newline "$item" 2>/dev/null) || exit 0
[ -n "$token" ] || exit 0

# GitLab accepts any non-blank username alongside a PAT; oauth2 is the
# conventional placeholder.
printf 'username=oauth2\npassword=%s\n' "$token"
